# Services bind to loopback by default. Change only when a protected ingress is used.
GPU_OPS_BIND_ADDRESS=127.0.0.1

# Local development defaults. To enable authentication, replace this empty map
# with distinct high-entropy keys before setting GPU_OPS_AUTH_ENABLED=true.
GPU_OPS_AUTH_ENABLED=false
GPU_OPS_API_KEYS={}

GPU_OPS_AUDIT_RETENTION_DAYS=90
GPU_OPS_AUDIT_MAX_ROWS=100000
